{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wallcrawl.local/schemas/reviewed-exercise-metadata-v3.json",
  "title": "WallCrawl reviewed exercise metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exercises"],
  "properties": {
    "schemaVersion": {"type": "integer", "enum": [2, 3]},
    "exercises": {
      "type": "object",
      "maxProperties": 500,
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
      "additionalProperties": {"$ref": "#/$defs/reviewedExerciseMetadata"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion"]},
      "then": {
        "properties": {
          "exercises": {"additionalProperties": {"$ref": "#/$defs/version2Entry"}}
        }
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"const": 3}}, "required": ["schemaVersion"]},
      "then": {
        "properties": {
          "exercises": {"additionalProperties": {"$ref": "#/$defs/version3Entry"}}
        }
      }
    }
  ],
  "$defs": {
    "version2Entry": {
      "type": "object",
      "properties": {
        "reviewState": {"type": "string", "enum": ["draft", "approved"]},
        "provenance": {"properties": {"schemaVersion": {"const": 2}}}
      }
    },
    "version3Entry": {
      "type": "object",
      "properties": {
        "provenance": {"properties": {"schemaVersion": {"const": 3}}}
      }
    },
    "canonicalMuscle": {
      "type": "string",
      "enum": [
        "Chest", "Shoulders", "Rear Delts", "Triceps", "Back", "Upper Back",
        "Lower Back", "Lats", "Biceps", "Forearms", "Quadriceps", "Hamstrings",
        "Glutes", "Adductors", "Calves", "Hips", "Core"
      ]
    },
    "equipment": {
      "type": "string",
      "enum": [
        "Barbell", "Dumbbell", "Cable", "Machine", "Bodyweight", "Kettlebell",
        "Resistance Band", "Bench", "Pull-up Bar", "Dip Bars", "Squat Rack", "Box",
        "Cardio", "Chair", "Doorway", "Plate", "Stability Ball", "Towel", "Wall",
        "Band Anchor - Upper Body", "Band Anchor - Overhead", "Band Anchor - Low",
        "Band Kickback Attachment and Support"
      ]
    },
    "exerciseLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseId"],
      "properties": {
        "exerciseId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerRole", "rationaleOrSource", "reviewedAtEpochMillis",
        "schemaVersion", "policyVersion"
      ],
      "properties": {
        "reviewerRole": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "rationaleOrSource": {"type": "string", "minLength": 1, "maxLength": 1000},
        "reviewedAtEpochMillis": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 253402300799999
        },
        "schemaVersion": {"type": "integer", "enum": [2, 3]},
        "policyVersion": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "aiReviewProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerModelId", "reviewedAtEpochMillis", "reviewedContentId",
        "reviewedContentSha256", "sourceReferences", "decisionRationale", "limitations",
        "schemaVersion", "policyVersion"
      ],
      "properties": {
        "reviewerModelId": {"type": "string", "minLength": 1, "maxLength": 120},
        "reviewedAtEpochMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 253402300799999
        },
        "reviewedContentId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 128
        },
        "reviewedContentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sourceReferences": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {
            "type": "string", "minLength": 1, "maxLength": 2048,
            "pattern": "^https://"
          }
        },
        "decisionRationale": {"type": "string", "minLength": 1, "maxLength": 1000},
        "limitations": {"type": "string", "minLength": 1, "maxLength": 1000},
        "schemaVersion": {"type": "integer", "const": 3},
        "policyVersion": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "reviewedExerciseMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewState", "directPrimaryMuscle", "descriptiveSecondaryMuscles",
        "movementPattern", "complexity", "progressionFamily", "prescriptionShape",
        "approvedRegressions", "approvedSubstitutions", "capabilityRequirements",
        "supportRequirement", "impactLevel", "equipmentAlternatives",
        "clearedTrainingConstraints", "provenance"
      ],
      "properties": {
        "reviewState": {"type": "string", "enum": ["draft", "approved", "ai_accepted"]},
        "directPrimaryMuscle": {"$ref": "#/$defs/canonicalMuscle"},
        "descriptiveSecondaryMuscles": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalMuscle"}
        },
        "movementPattern": {
          "type": "string",
          "enum": [
            "horizontal_push", "vertical_push", "horizontal_pull", "vertical_pull",
            "squat", "hinge", "lunge", "isolation", "carry", "core", "other"
          ]
        },
        "complexity": {"type": "string", "enum": ["foundational", "standard", "advanced"]},
        "progressionFamily": {
          "type": "string", "minLength": 1, "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "prescriptionShape": {
          "type": "string",
          "enum": ["weight_reps", "bodyweight_reps", "assisted_bodyweight", "duration"]
        },
        "approvedRegressions": {
          "type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/exerciseLink"}
        },
        "approvedSubstitutions": {
          "type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/exerciseLink"}
        },
        "capabilityRequirements": {
          "type": "array", "maxItems": 7, "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "impact", "floor_transition", "unsupported_squat",
              "upper_body_bodyweight_push", "vertical_pull_or_hang",
              "balance_without_support", "continuous_activity"
            ]
          }
        },
        "supportRequirement": {
          "type": "string", "enum": ["supported", "optional_support", "unsupported"]
        },
        "impactLevel": {"type": "string", "enum": ["none", "low", "high"]},
        "equipmentAlternatives": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
            "items": {"$ref": "#/$defs/equipment"}
          }
        },
        "clearedTrainingConstraints": {
          "type": "array", "maxItems": 6, "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "shoulder_sensitive", "elbow_sensitive", "wrist_sensitive",
              "lower_back_sensitive", "hip_sensitive", "knee_sensitive"
            ]
          }
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "aiReviewProvenance": {"$ref": "#/$defs/aiReviewProvenance"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"reviewState": {"const": "ai_accepted"}},
            "required": ["reviewState"]
          },
          "then": {
            "required": ["aiReviewProvenance"],
            "properties": {
              "provenance": {
                "properties": {
                  "reviewerRole": {"type": "null"},
                  "reviewedAtEpochMillis": {"type": "null"},
                  "schemaVersion": {"const": 3}
                }
              }
            }
          },
          "else": {"not": {"required": ["aiReviewProvenance"]}}
        },
        {
          "if": {
            "properties": {"reviewState": {"const": "approved"}},
            "required": ["reviewState"]
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "reviewerRole": {"type": "string"},
                  "reviewedAtEpochMillis": {"type": "integer"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"reviewState": {"const": "draft"}},
            "required": ["reviewState"]
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "reviewerRole": {"type": "null"},
                  "reviewedAtEpochMillis": {"type": "null"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
